@{
    ViewData["Title"] = "Головне меню";
}

<div class="text-center my-4">
    <h1 class="display-4 fw-bold text-primary">ІС «Навчальний IT-центр»</h1>
    <p class="lead text-muted">Головна форма-меню керування базою даних</p>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-start border-4 border-info">
            <div class="card-body">
                <h5 class="card-title fw-bold text-info">Користувачі та Структура</h5>
                <p class="card-text text-muted">Введення та редагування списків студентів, викладачів, груп та аудиторій.</p>
                <div class="d-grid gap-2">
                    <a href="/Students/Create" class="btn btn-outline-info text-dark text-start">👤 Форма: Додати нового Студента</a>
                    <a href="/Teachers/Create" class="btn btn-outline-info text-dark text-start">👨‍🏫 Форма: Додати нового Викладача</a>
                    <a href="/Groups/Create" class="btn btn-outline-info text-dark text-start">👥 Форма: Створити навчальну Групу</a>
                    <a href="/Auditoriums/Create" class="btn btn-outline-info text-dark text-start">🚪 Форма: Зареєструвати Аудиторію</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-start border-4 border-success">
            <div class="card-body">
                <h5 class="card-title fw-bold text-success">Навчальні програми та Сертифікація</h5>
                <p class="card-text text-muted">Керування курсами, поділ на змістовні модулі та фіксація видачі сертифікатів.</p>
                <div class="d-grid gap-2">
                    <a href="/Courses" class="btn btn-outline-success text-dark text-start">📚 Керування Курсами та Модулями</a>
                    <a href="/CourseAssignments/Create" class="btn btn-outline-success text-dark text-start">🔗 Форма: Призначити викладача на курс групи</a>
                    <a href="/Certificates/Create" class="btn btn-outline-success text-dark text-start">🎓 Форма: Видати Сертифікат</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow-sm border-secondary">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">📊 Аналітика та Запити (Частина 3)</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 border-end">
                        <h6 class="text-primary fw-bold mb-3">Прості параметризовані запити (Більше 1 таблиці)</h6>
                        <div class="d-grid gap-2">
                            <a href="/Queries/Query1" class="btn btn-outline-primary text-start">1. Студенти певної групи</a>
                            <a href="/Queries/Query2" class="btn btn-outline-primary text-start">2. Сертифікати, видані за курс</a>
                            <a href="/Queries/Query3" class="btn btn-outline-primary text-start">3. Модулі курсу за тривалістю (годин)</a>
                            <a href="/Queries/Query4" class="btn btn-outline-primary text-start">4. Розклад аудиторії (Групи в кабінеті)</a>
                            <a href="/Queries/Query5" class="btn btn-outline-primary text-start">5. Викладачі, призначені на курс</a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-danger fw-bold mb-3">Запити з множинними порівняннями</h6>
                        <div class="d-grid gap-2">
                            <a href="/Queries/Multiple1" class="btn btn-outline-danger text-start">✨ Викладачі з однаковим набором курсів</a>
                            <a href="/Queries/Multiple2" class="btn btn-outline-danger text-start">✨ Студенти з сертифікатами як у заданого</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>