@model IEnumerable<DB_ex_proj.Models.CourseAssignment>

@{
    ViewData["Title"] = "Запит 5";
}

<div class="container mt-4">
    <h2 class="text-primary">🔍 Запит 5: Викладачі на курсі</h2>
    <p class="text-muted">Демонстрація тернарного зв'язку: <b>Teachers, Courses, Groups</b>.</p>

    <div class="card shadow-sm mb-4 border-success">
        <div class="card-body">
            <form asp-action="Query5" method="get" class="d-flex align-items-end gap-3">
                <div class="flex-grow-1">
                    <label for="courseTitle" class="form-label fw-bold">Назва курсу (або частина):</label>
                    <input type="text" id="courseTitle" name="courseTitle" class="form-control border-success" placeholder="Напр: ASP.NET Core" value="@ViewBag.SearchParameter" required />
                </div>
                <button type="submit" class="btn btn-success">Шукати викладачів</button>
                <a href="/" class="btn btn-outline-secondary">↩ Меню</a>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-hover table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Викладач (ПІБ)</th>
                    <th>Спеціалізація</th>
                    <th>Навчальний курс</th>
                    <th>Викладає для групи</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Teacher.FullName</td>
                        <td>@item.Teacher.Specialization</td>
                        <td class="text-success fw-bold">@item.Course.Title</td>
                        <td><span class="badge bg-secondary">@item.Group.Name</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (ViewBag.SearchParameter != null)
    {
        <div class="alert alert-warning">Для курсу "<b>@ViewBag.SearchParameter</b>" ще не призначено жодного викладача.</div>
    }
</div>