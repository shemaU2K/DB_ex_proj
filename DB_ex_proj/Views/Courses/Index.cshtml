@model IEnumerable<DB_ex_proj.Models.Course>

@{
    ViewData["Title"] = "Навчальні курси";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold">📚 Перегляд навчальних курсів</h2>
        <a asp-action="Create" class="btn btn-success">➕ Створити новий Курс</a>
    </div>

    <p class="text-muted">У цій таблиці відображаються всі доступні програми. Натисніть «Деталі», щоб перейти до вкладеної форми керування модулями.</p>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-success">
                    <tr>
                        <th style="width: 25%">Назва курсу</th>
                        <th style="width: 50%">Опис програми</th>
                        <th style="width: 10%">Тривалість</th>
                        <th style="width: 15%" class="text-center">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Title</td>
                            <td class="text-truncate" style="max-width: 300px;">@item.Description</td>
                            <td>@item.Duration год.</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    🔍 Деталі / Модулі
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a href="/" class="btn btn-outline-secondary">↩ Повернутись до головного меню</a>
    </div>
</div>