@model DB_ex_proj.Models.Certificate

@{
    ViewData["Title"] = "Видача сертифіката";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-dark">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">🎓 Видача нового Сертифіката</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="CertificateCode" class="form-label fw-bold">Унікальний код сертифіката</label>
                        <input asp-for="CertificateCode" class="form-control" required placeholder="Напр: CERT-2026-099" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="IssueDate" class="form-label fw-bold">Дата видачі</label>
                        <input asp-for="IssueDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="StudentId" class="form-label text-primary fw-bold">Оберіть Студента</label>
                        <select asp-for="StudentId" class="form-select border-primary" asp-items="ViewBag.Students" required>
                            <option value="">-- Зі списку студентів --</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CourseId" class="form-label text-success fw-bold">За який Курс</label>
                        <select asp-for="CourseId" class="form-select border-success" asp-items="ViewBag.Courses" required>
                            <option value="">-- Зі списку навчальних програм --</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/" class="btn btn-outline-secondary">↩ Повернутись до меню</a>
                        <button type="submit" class="btn btn-dark">💾 Зберегти сертифікат</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>